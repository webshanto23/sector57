DATABASE_URL=postgresql://sector57:PASSWORD@localhost:5432/sector57_dev
TEST_DATABASE_URL=postgresql://sector57:PASSWORD@localhost:5432/sector57_test
# Signs login tokens: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-at-least-32-random-characters
PORT=4000
NODE_ENV=development
DEFAULT_SOCIETY_SLUG=sector57
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Seconds the dashboard overview keeps a caller's figures; 0 makes every load live.
OVERVIEW_CACHE_SECONDS=30
# Public base URL of uploaded files. Dev: the API serves them at /media, reached through the
# web app's /api proxy. Droplet: https://<domain>/media (Nginx serves MEDIA_DIR). Empty: no photos shown.
MEDIA_BASE_URL=http://localhost:3000/api/media
# Folder for uploaded files, relative to apps/api (git-ignored).
MEDIA_DIR=media
# Private uploads (deeds, NID copies from the public forms), relative to apps/api (git-ignored).
# Never inside MEDIA_DIR, never served by Nginx; the API sends them only to permitted users.
PRIVATE_MEDIA_DIR=private-media
# Serve MEDIA_DIR at /media from the API. Defaults to true outside production; false behind Nginx.
# MEDIA_SERVE=true
