  societies    societies @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenancies    tenancies @relation(fields: [tenancy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notices {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id           String     @db.Uuid
