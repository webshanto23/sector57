/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoices {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id              String                @db.Uuid
  invoice_no              String
  unit_id                 String?               @db.Uuid
  bill_to_person_id       String?               @db.Uuid
  bill_to_organisation_id String?               @db.Uuid
  period_start            DateTime?             @db.Date
  period_end              DateTime?             @db.Date
  issue_date              DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date                DateTime              @db.Date
  total                   Decimal               @default(0) @db.Decimal(14, 2)
  paid                    Decimal               @default(0) @db.Decimal(14, 2)
  status                  String                @default("unpaid")
  created_by              String?               @db.Uuid
  created_at              DateTime              @default(now()) @db.Timestamptz(6)
  kind                    String                @default("regular")
  fund_id                 String                @db.Uuid
  membership_id           String?               @db.Uuid
  bill_to_snapshot        Json?
  void_reason             String?
  voided_at               DateTime?             @db.Timestamptz(6)
  voided_by               String?               @db.Uuid
  billing_run_id          String?               @db.Uuid
  invoice_lines           invoice_lines[]
  billing_runs            billing_runs?         @relation(fields: [billing_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funds                   funds                 @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships             memberships?          @relation(fields: [membership_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organisations           organisations?        @relation(fields: [bill_to_organisation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons                 persons?              @relation(fields: [bill_to_person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                   users?                @relation("invoices_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_voided            users?                @relation("invoices_voided_byTousers", fields: [voided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies               societies             @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  units                   units?                @relation(fields: [unit_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)
  payment_allocations     payment_allocations[]

  @@unique([society_id, invoice_no])
  @@unique([unit_id], map: "invoices_one_opening_uq", where: raw("((kind = 'opening'::text) AND (status <> 'void'::text))"))
  @@index([society_id, status, due_date], map: "invoices_status_idx")
  @@index([unit_id, status], map: "invoices_unit_idx")
  @@index([society_id, issue_date], map: "invoices_issue_idx")
  @@index([bill_to_person_id], map: "invoices_person_idx", where: raw("(bill_to_person_id IS NOT NULL)"))
  @@index([bill_to_organisation_id], map: "invoices_organisation_idx", where: raw("(bill_to_organisation_id IS NOT NULL)"))
  @@index([membership_id], map: "invoices_membership_idx", where: raw("(membership_id IS NOT NULL)"))
