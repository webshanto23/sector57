  payments_voided                         payments[]         @relation("payments_voided_byTousers")
  handovers_collected                     cash_handovers[]   @relation("cash_handovers_collector_idTousers")
  handovers_confirmed                     cash_handovers[]   @relation("cash_handovers_confirmed_byTousers")
  budgets                                 budgets[]
