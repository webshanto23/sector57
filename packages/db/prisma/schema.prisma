  charge_schedules charge_schedules? @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  units            units?            @relation(fields: [unit_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schedule_id, unit_id, period_start], map: "invoice_lines_once_uq", where: raw("(schedule_id IS NOT NULL)"))
  @@index([invoice_id], map: "invoice_lines_invoice_idx")
