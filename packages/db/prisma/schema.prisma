/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model location_levels {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id    String      @db.Uuid
  depth         Int         @db.SmallInt
  name_bn       String
  name_en       String?
  is_unit_level Boolean     @default(false)
  societies     societies   @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  locations     locations[]

  @@unique([society_id, depth])
  @@unique([society_id, name_bn])
}

model locations {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id       String             @db.Uuid
  parent_id        String?            @db.Uuid
  level_id         String             @db.Uuid
  name             String
  code             String?
  path             String
  attributes       Json               @default("{}")
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  charge_schedules charge_schedules[]
  funds            funds[]
  location_levels  location_levels    @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations        locations?         @relation("locationsTolocations", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_locations  locations[]        @relation("locationsTolocations")
  societies        societies          @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notices          notices[]
  ownerships       ownerships[]
  units            units?
  user_roles       user_roles[]

  @@unique([society_id, parent_id, name])
  @@unique([society_id, path], map: "locations_path_uq")
  @@unique([society_id, name], map: "locations_root_name_uq", where: raw("(parent_id IS NULL)"))
  @@unique([society_id, code], map: "locations_code_uq", where: raw("(code IS NOT NULL)"))
  @@index([parent_id], map: "locations_parent_idx")
  @@index([society_id, path], map: "locations_path_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "locations_name_trgm", type: Gin)
}

