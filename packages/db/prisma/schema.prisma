generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  id          BigInt    @id @default(autoincrement())
  society_id  String    @db.Uuid
  user_id     String?   @db.Uuid
  action      String
  entity_type String
  entity_id   String?   @db.Uuid
  before_data Json?
  after_data  Json?
  ip_address  String?   @db.Inet
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  societies   societies @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "audit_entity_idx")
  @@index([society_id, created_at(sort: Desc)], map: "audit_time_idx")
  @@index([society_id, user_id, created_at(sort: Desc)], map: "audit_user_time_idx")
  @@index([society_id, entity_type, created_at(sort: Desc)], map: "audit_type_time_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model budgets {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id      String        @db.Uuid
  fiscal_year     String
  expense_head_id String        @db.Uuid
  amount          Decimal       @db.Decimal(14, 2)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_by      String?       @db.Uuid
  expense_heads   expense_heads @relation(fields: [expense_head_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies       societies     @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?        @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([society_id, fiscal_year, expense_head_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model charge_schedules {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id        String                  @db.Uuid
  charge_type_id    String                  @db.Uuid
  amount            Decimal                 @db.Decimal(14, 2)
  frequency_months  Int?                    @db.SmallInt
  generation        String                  @default("auto")
  scope_location_id String?                 @db.Uuid
  unit_types        String[]
  starts_on         DateTime                @db.Date
  ends_on           DateTime?               @db.Date
  next_run_on       DateTime?               @db.Date
  status            String                  @default("active")
  created_by        String?                 @db.Uuid
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  name_bn           String
  name_en           String?
  due_days          Int                     @default(15) @db.SmallInt
  updated_at        DateTime                @default(now()) @db.Timestamptz(6)
  charge_types      charge_types            @relation(fields: [charge_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations         locations?              @relation(fields: [scope_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies         societies               @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice_lines     invoice_lines[]
  rates             charge_schedule_rates[]

  @@index([society_id, next_run_on], map: "charge_schedules_due_idx", where: raw("(status = 'active'::text)"))
}

model charge_schedule_rates {
  schedule_id      String           @db.Uuid
  location_id      String           @db.Uuid
  amount           Decimal          @db.Decimal(14, 2)
  charge_schedules charge_schedules @relation(fields: [schedule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  locations        locations        @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([schedule_id, location_id])
  @@index([location_id], map: "charge_schedule_rates_location_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model billing_runs {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id    String     @db.Uuid
  period        DateTime   @db.Date
  trigger       String
  status        String
  started_by    String?    @db.Uuid
  started_at    DateTime   @default(now()) @db.Timestamptz(6)
  finished_at   DateTime?  @db.Timestamptz(6)
  invoice_count Int        @default(0)
  total         Decimal    @default(0) @db.Decimal(16, 2)
  skipped       Json       @default("[]")
  error         String?
  invoices      invoices[]
  societies     societies  @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?     @relation(fields: [started_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([society_id, started_at(sort: Desc)], map: "billing_runs_society_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model charge_types {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id       String             @db.Uuid
  name_bn          String
  name_en          String?
  kind             String
  fund_id          String             @db.Uuid
  default_amount   Decimal?           @db.Decimal(14, 2)
  archived_at      DateTime?          @db.Timestamptz(6)
  charge_schedules charge_schedules[]
  funds            funds              @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies        societies          @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice_lines    invoice_lines[]

  @@unique([society_id, name_bn])
}

model committee_members {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id String    @db.Uuid
  person_id  String    @db.Uuid
  position   String
  sort_order Int       @default(0) @db.SmallInt
  term_start DateTime  @db.Date
  term_end   DateTime? @db.Date
  persons    persons   @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies  societies @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Files kept with a record: form uploads, expense vouchers, and (Step 21) society papers and person or place documents. Archived, never deleted from the library; the archive fields go together (check, migration 14_documents).
model documents {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id  String       @db.Uuid
  entity_type String
  entity_id   String       @db.Uuid
  doc_type    String
  file_url    String
  file_name   String
  visibility  String       @default("office")
  uploaded_by String?      @db.Uuid
  uploaded_at DateTime     @default(now()) @db.Timestamptz(6)
  title       String?
  archived_at DateTime?    @db.Timestamptz(6)
  archived_by String?      @db.Uuid
  societies   societies    @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?       @relation("documents_uploaded_byTousers", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  archiver    users?       @relation("documents_archived_byTousers", fields: [archived_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownerships  ownerships[]

  @@index([entity_type, entity_id], map: "documents_entity_idx")
  @@index([society_id, entity_type, uploaded_at(sort: Desc)], map: "documents_society_entity_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model donations {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id            String         @db.Uuid
  donor_person_id       String?        @db.Uuid
  donor_organisation_id String?        @db.Uuid
  fund_id               String         @db.Uuid
  purpose               String?
  amount                Decimal        @db.Decimal(14, 2)
  payment_id            String         @unique(map: "donations_payment_uq") @db.Uuid
  received_at           DateTime       @default(now()) @db.Timestamptz(6)
  organisations         organisations? @relation(fields: [donor_organisation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons               persons?       @relation(fields: [donor_person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funds                 funds          @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments              payments       @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies             societies      @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([society_id, received_at(sort: Desc)], map: "donations_received_idx")
  @@index([donor_person_id], map: "donations_person_idx", where: raw("(donor_person_id IS NOT NULL)"))
  @@index([donor_organisation_id], map: "donations_organisation_idx", where: raw("(donor_organisation_id IS NOT NULL)"))
  @@index([fund_id], map: "donations_fund_idx")
}

model expense_heads {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id  String     @db.Uuid
  name_bn     String
  name_en     String?
  archived_at DateTime?  @db.Timestamptz(6)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  budgets     budgets[]
  societies   societies  @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenses    expenses[]

  @@unique([society_id, name_bn])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expenses {
  id                                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id                         String        @db.Uuid
  expense_head_id                    String        @db.Uuid
  fund_id                            String        @db.Uuid
  vendor_id                          String?       @db.Uuid
  description                        String
  amount                             Decimal       @db.Decimal(14, 2)
  spent_on                           DateTime      @db.Date
  status                             String        @default("pending")
  requested_by                       String?       @db.Uuid
  approved_by                        String?       @db.Uuid
  approved_at                        DateTime?     @db.Timestamptz(6)
  created_at                         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime      @default(now()) @db.Timestamptz(6)
  rejected_by                        String?       @db.Uuid
  rejected_at                        DateTime?     @db.Timestamptz(6)
  reject_reason                      String?
  voucher_no                         String?
  paid_at                            DateTime?     @db.Timestamptz(6)
  paid_by                            String?       @db.Uuid
  paid_account                       String?
  voided_at                          DateTime?     @db.Timestamptz(6)
  voided_by                          String?       @db.Uuid
  void_reason                        String?
  users_expenses_approved_byTousers  users?        @relation("expenses_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expense_heads                      expense_heads @relation(fields: [expense_head_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funds                              funds         @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_expenses_paid_byTousers      users?        @relation("expenses_paid_byTousers", fields: [paid_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_expenses_rejected_byTousers  users?        @relation("expenses_rejected_byTousers", fields: [rejected_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_expenses_requested_byTousers users?        @relation("expenses_requested_byTousers", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies                          societies     @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendors                            vendors?      @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_expenses_voided_byTousers    users?        @relation("expenses_voided_byTousers", fields: [voided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([society_id, voucher_no], map: "expenses_voucher_uq", where: raw("(voucher_no IS NOT NULL)"))
  @@index([fund_id], map: "expenses_fund_idx")
  @@index([expense_head_id], map: "expenses_head_idx")
  @@index([society_id, spent_on(sort: Desc)], map: "expenses_society_idx")
  @@index([society_id, status], map: "expenses_status_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model form_submissions {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id   String        @db.Uuid
  form_key     String
  data         Json
  status       String        @default("new")
  reviewed_by  String?       @db.Uuid
  submitted_at DateTime      @default(now()) @db.Timestamptz(6)
  location_id  String?       @db.Uuid
  reference    String
  phone        String?
  person_id    String?       @db.Uuid
  review_note  String?
  reviewed_at  DateTime?     @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  users        users?        @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies    societies     @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  locations    locations?    @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons      persons?      @relation(fields: [person_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  memberships  memberships[]

  @@unique([society_id, reference], map: "form_submissions_reference_uq")
  @@index([society_id, status, submitted_at(sort: Desc)], map: "form_submissions_queue_idx")
  @@index([society_id, phone, submitted_at(sort: Desc)], map: "form_submissions_phone_idx")
  @@index([location_id], map: "form_submissions_location_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model memberships {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id       String            @db.Uuid
  person_id        String            @db.Uuid
  location_id      String?           @db.Uuid
  member_no        Int
  status           String            @default("active")
  joined_on        DateTime          @db.Date
  ended_on         DateTime?         @db.Date
  submission_id    String?           @db.Uuid
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  societies        societies         @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  persons          persons           @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations        locations?        @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  form_submissions form_submissions? @relation(fields: [submission_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invoices         invoices[]

  @@unique([society_id, member_no], map: "memberships_member_no_uq")
  @@unique([person_id], map: "memberships_active_person_uq", where: raw("(status = 'active'::text)"))
  @@index([location_id], map: "memberships_location_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Money moved between funds or between a fund's cash and bank: two ledger rows each. Only voided, never changed or deleted (trigger).
model fund_transfers {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id    String    @db.Uuid
  from_fund_id  String    @db.Uuid
  from_account  String
  to_fund_id    String    @db.Uuid
  to_account    String
  amount        Decimal   @db.Decimal(14, 2)
  transfer_date DateTime  @db.Date
  memo          String?
  created_by    String    @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  voided_at     DateTime? @db.Timestamptz(6)
  voided_by     String?   @db.Uuid
  void_reason   String?
  societies     societies @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  from_fund     funds     @relation("fund_transfers_from", fields: [from_fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_fund       funds     @relation("fund_transfers_to", fields: [to_fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_created users     @relation("fund_transfers_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_voided  users?    @relation("fund_transfers_voided_byTousers", fields: [voided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([society_id, transfer_date(sort: Desc)], map: "fund_transfers_society_idx")
}

model funds {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id     String           @db.Uuid
  name_bn        String
  name_en        String?
  location_id    String?          @db.Uuid
  is_default     Boolean          @default(false)
  closed_at      DateTime?        @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  charge_types   charge_types[]
  donations      donations[]
  expenses       expenses[]
  invoices       invoices[]
  locations      locations?       @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  societies      societies        @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ledger_entries ledger_entries[]
  transfers_out  fund_transfers[] @relation("fund_transfers_from")
  transfers_in   fund_transfers[] @relation("fund_transfers_to")

  @@unique([society_id, name_bn])
  @@unique([society_id], map: "funds_one_default_uq", where: raw("is_default"))
}

model gallery_albums {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id     String           @db.Uuid
  title_bn       String
  title_en       String?
  event_date     DateTime?        @db.Date
  is_published   Boolean          @default(false)
  societies      societies        @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gallery_photos gallery_photos[]
}

model gallery_photos {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  album_id       String         @db.Uuid
  file_url       String
  caption_bn     String?
  caption_en     String?
  sort_order     Int            @default(0)
  gallery_albums gallery_albums @relation(fields: [album_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_lines {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id       String            @db.Uuid
  charge_type_id   String            @db.Uuid
  schedule_id      String?           @db.Uuid
  unit_id          String?           @db.Uuid
  period_start     DateTime?         @db.Date
  description      String
  amount           Decimal           @db.Decimal(14, 2)
  description_en   String?
  position         Int               @default(0) @db.SmallInt
