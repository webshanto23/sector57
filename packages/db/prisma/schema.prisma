  societies         societies                @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tickets           tickets?                 @relation(fields: [ticket_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets            assets?                  @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plans             asset_maintenance_plans? @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations         locations                @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff             staff?                   @relation(fields: [assigned_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors           vendors?                 @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenses          expenses?                @relation(fields: [expense_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?                   @relation("work_orders_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([society_id, wo_no], map: "work_orders_no_uq")
  @@unique([expense_id], map: "work_orders_expense_uq", where: raw("(expense_id IS NOT NULL)"))
  @@index([society_id, status], map: "work_orders_society_idx")
  @@index([location_id], map: "work_orders_location_idx")
  @@index([ticket_id], map: "work_orders_ticket_idx")
  @@index([asset_id], map: "work_orders_asset_idx")
  @@index([plan_id], map: "work_orders_plan_idx")
