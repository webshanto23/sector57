/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// One staff stint's pay in a run. net = base − attendance_deduction + allowances − deductions
/// (check). Changes only while the run is a draft (trigger).
model payslips {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id           String          @db.Uuid
  run_id               String          @db.Uuid
  staff_id             String          @db.Uuid
  fund_id              String          @db.Uuid
  kind                 String
  rate                 Decimal         @db.Decimal(14, 2)
  days_in_month        Int             @db.SmallInt
  days_employed        Int             @db.SmallInt
  present_days         Int             @db.SmallInt
  half_days            Int             @db.SmallInt
  absent_days          Int             @db.SmallInt
  base                 Decimal         @db.Decimal(14, 2)
  attendance_deduction Decimal         @db.Decimal(14, 2)
  allowances           Decimal         @default(0) @db.Decimal(14, 2)
  deductions           Decimal         @default(0) @db.Decimal(14, 2)
  net                  Decimal         @db.Decimal(14, 2)
  note                 String?
  updated_at           DateTime        @default(now()) @db.Timestamptz(6)
  societies            societies       @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payroll_runs         payroll_runs    @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff                staff           @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funds                funds           @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payslip_lines        payslip_lines[]

  @@unique([run_id, staff_id], map: "payslips_run_staff_uq")
  @@index([staff_id], map: "payslips_staff_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// A named allowance or deduction on a payslip.
model payslip_lines {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payslip_id String   @db.Uuid
  kind       String
  label_bn   String
  label_en   String?
  amount     Decimal  @db.Decimal(14, 2)
  position   Int      @db.SmallInt
  payslips   payslips @relation(fields: [payslip_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payslip_id, position], map: "payslip_lines_payslip_idx")
}

/// The expenses a paid run booked, one per fund. Written once (trigger).
model payroll_run_expenses {
  run_id       String       @db.Uuid
  expense_id   String       @unique(map: "payroll_run_expenses_expense_uq") @db.Uuid
  fund_id      String       @db.Uuid
  payroll_runs payroll_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenses     expenses     @relation(fields: [expense_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funds        funds        @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([run_id, expense_id])
  @@unique([run_id, fund_id], map: "payroll_run_expenses_fund_uq")
}

