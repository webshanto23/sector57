{
  "name": "@s57/db",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "seed": "tsx prisma/seed.ts",
    "test:prepare": "node scripts/with-test-db.mjs prisma migrate deploy --config prisma7.config.ts && node scripts/with-test-db.mjs tsx prisma/seed.ts",
    "studio": "prisma studio --config prisma7.config.ts",
    "generate": "prisma generate --config prisma7.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json",
    "migrate:resolve-baseline": "prisma migrate resolve --applied 00_init --config prisma7.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15"
  }
}
