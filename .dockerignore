# `**/` so nested folders (apps/web/.next, apps/*/node_modules, ...) are skipped too;
# a bare name only matches at the repo root.
**/node_modules
**/.pnpm-store
**/.turbo
**/dist
**/.next
**/coverage
**/*.tsbuildinfo
**/next-env.d.ts
# Regenerated inside the image by `prisma generate`
packages/db/generated
# Uploaded files stay on the host (compose mounts a volume)
apps/api/media
apps/api/private-media

.git
.github
docs
*.dump
*.log

**/.env
**/.env.*
!**/.env.example

Dockerfile
docker-compose*.yml
README.md
